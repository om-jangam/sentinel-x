# Sentinel-X configuration contract. Copy to `.env` and adjust. Never commit real secrets.
# Every backend variable is prefixed SENTINELX_ (see backend/app/core/config.py).

# --- runtime
SENTINELX_ENVIRONMENT=development          # development | test | production
SENTINELX_LOG_LEVEL=INFO
SENTINELX_LOG_JSON=true
SENTINELX_EXPOSE_API_DOCS=true

# --- persistence
SENTINELX_DATABASE_URL=postgresql+asyncpg://sentinelx:sentinelx@localhost:5432/sentinelx
SENTINELX_REDIS_URL=redis://localhost:6379/0   # required in production (blocklist, rate limits, bus)

# --- event store (OpenSearch). Unset: ingestion still authenticates and validates, but events are
# neither indexed nor searchable, and /api/v1/events/* returns 503. Required in production.
# SENTINELX_OPENSEARCH_URL=http://localhost:9200
# SENTINELX_OPENSEARCH_USERNAME=
# SENTINELX_OPENSEARCH_PASSWORD=
SENTINELX_OPENSEARCH_VERIFY_CERTS=true
SENTINELX_OPENSEARCH_SHARDS=1
SENTINELX_OPENSEARCH_REPLICAS=0
SENTINELX_EVENT_RETENTION_DAYS=90

# --- threat intelligence (ADR-0018). Every provider is optional; with none, incidents simply carry no
#     intel. External providers receive indicators (external IPs, domains, hashes) - never internal hosts.
# SENTINELX_TI_LOCAL_FEED=../pipeline/intel/demo_indicators.csv   # CSV or JSON indicator file
# SENTINELX_OTX_API_KEY=                                          # AlienVault OTX; unset = no external lookups
# SENTINELX_OTX_BASE_URL=https://otx.alienvault.com
# SENTINELX_TI_CACHE_HOURS=24
# SENTINELX_TI_TIMEOUT_SECONDS=5

# --- AI investigation assistant (ADR-0019). Off unless a provider is set; the workspace works without it.
#     "ollama" keeps evidence on this host; "openai" (any OpenAI-compatible endpoint) sends it there.
# SENTINELX_AI_PROVIDER=ollama
# SENTINELX_AI_MODEL=qwen2.5:3b
# SENTINELX_AI_BASE_URL=http://127.0.0.1:11434        # production: https unless it points at this host
# SENTINELX_AI_API_KEY=                               # OpenAI-compatible endpoints only
# SENTINELX_AI_TIMEOUT_SECONDS=180
# SENTINELX_AI_CONTEXT_TOKENS=16384

# --- ingestion (per-source request rate; body and batch caps are fixed at 5 MiB / 1,000 events)
SENTINELX_INGEST_RATE_LIMIT=600
SENTINELX_INGEST_RATE_WINDOW_SECONDS=60

# --- HTTP
SENTINELX_CORS_ORIGINS=["http://localhost:5173"]

# --- tokens (ADR-0010). Generate with: uv run sentinelx generate-keys
SENTINELX_JWT_PRIVATE_KEY_FILE=../.secrets/jwt_private.pem
# SENTINELX_JWT_PREVIOUS_PUBLIC_KEY_FILE=../.secrets/jwt_previous_public.pem   # during key rotation
SENTINELX_ACCESS_TOKEN_TTL_SECONDS=600
SENTINELX_REFRESH_TOKEN_TTL_SECONDS=604800
SENTINELX_COOKIE_SECURE=true                # browsers accept Secure cookies on http://localhost

# --- password hashing (argon2id; production enforces OWASP minimums)
SENTINELX_ARGON2_TIME_COST=3
SENTINELX_ARGON2_MEMORY_COST_KIB=65536
SENTINELX_ARGON2_PARALLELISM=4

# --- abuse protection
SENTINELX_LOGIN_RATE_LIMIT=10
SENTINELX_LOGIN_RATE_WINDOW_SECONDS=300

# --- observability
SENTINELX_METRICS_ENABLED=true
SENTINELX_OTEL_ENABLED=false
# SENTINELX_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318/v1/traces

# --- bootstrap (read by `sentinelx seed`; prompts interactively when unset)
SENTINELX_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# SENTINELX_BOOTSTRAP_ADMIN_PASSWORD=
